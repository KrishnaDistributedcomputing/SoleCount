# Copy this file to fastlane/.env (scripts/setup_mac.sh does it for you).
# fastlane/.env is git-ignored. NEVER commit it or the .p8 key.
# Leave the Apple values blank until Apple emails you that your membership is active.
# The iPhone Simulator and `make test` work with them blank.

# App Store Connect API key (App Store Connect > Users and Access > Integrations)
ASC_KEY_ID=
ASC_ISSUER_ID=
# Full path to the downloaded key file, kept OUTSIDE the project folder:
ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Your 10-character Team ID (developer.apple.com/account > Membership details)
TEAM_ID=

# Optional. Only used on your Mac for the 2 steps Apple doesn't allow with an API key:
# creating the app record and uploading privacy answers. You'll get one 2FA prompt.
APPLE_ID=

# Optional: simulator used for tests and screenshots
SIM_DEVICE="iPhone 17 Pro Max"
# Optional: set to 1 to leave the EU out until your EU trader status is done
EXCLUDE_EU=0
